.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak
*.orig

# Node (if tooling is ever added)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build outputs (if a build step is added later)
dist/
build/
.cache/

# Environment / secrets
.env
.env.local
.env.*.local

# Logs
*.log

# Temporary files
tmp/
temp/

# Deployment platform artefacts
.netlify/
.vercel/
